{
  "openapi": "3.0.3",
  "info": {
    "title": "BDSPro Infrastructure API",
    "version": "0.1.0",
    "description": "Infrastructure-only API. Domain endpoints are intentionally absent."
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "HTTP readiness probe",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "HTTP handler is responding",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
