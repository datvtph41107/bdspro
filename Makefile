DB_URL ?= postgres://root:secret@127.0.0.1:5432/bdspro?sslmode=disable
DB_NAME ?= bdspro

.DEFAULT_GOAL := help

.PHONY: help dev-up dev-down dev postgres redis createdb migrateup migrateup1 migratedown migratedown1 new_migration sqlc format-check test test-race vet build check server swagger

help:
	@printf '%s\n' \
		'Local development (Docker Compose v2 + Go 1.27.3):' \
		'  make dev-up        Start PostgreSQL, Redis and Mailpit; wait for healthy dependencies' \
		'  make dev           Run API against the local Compose services with Mailpit SMTP' \
		'  make dev-down      Stop local dependencies; preserve named volumes' \
		'  make check         Formatting, Swagger coverage, tests, race, vet and build' \
		'  make sqlc          Regenerate SQLC output from db/query (modifies generated files)' \
		'  make migrateup     Apply migrations to DB_URL (development CLI)' \
		'  make migratedown1  Roll back one step; requires CONFIRM_MIGRATION_DOWN=yes' \
		'  make migratedown   Roll back all steps; requires CONFIRM_MIGRATION_DOWN=yes'

# Compose is the sole owner of local container names. No docker start by hand.
dev-up:
	docker compose up -d --wait postgres redis mailpit

dev-down:
	docker compose stop postgres redis mailpit

# The dev target intentionally uses local-only addresses, not a custom DB_SOURCE.
# Development mode auto-runs migrations. Never use application or production data.
dev:
	ENVIRONMENT=development \
	DB_SOURCE=postgresql://root:secret@127.0.0.1:5432/bdspro?sslmode=disable \
	REDIS_ADDRESS=127.0.0.1:6379 \
	HTTP_SERVER_ADDRESS=127.0.0.1:8080 \
	SMTP_ADDRESS=127.0.0.1:1025 \
	SMTP_AUTH=false \
	EMAIL_SENDER_ADDRESS=no-reply@bdspro.test \
	VERIFY_EMAIL_URL=http://127.0.0.1:8080/users/verify_email \
	go run .

postgres:
	docker compose up -d --wait postgres

redis:
	docker compose up -d --wait redis

# Compose creates bdspro on first initialization; use this for a different DB_NAME.
createdb:
	docker compose exec -T postgres createdb --username=root --owner=root $(DB_NAME)

migrateup:
	migrate -path db/migration -database "$(DB_URL)" -verbose up

migrateup1:
	migrate -path db/migration -database "$(DB_URL)" -verbose up 1

# Never permit an accidental full rollback, including on an overridden DB_URL.
# Explicit confirmation is an additional guard, not a production safety guarantee.
migratedown:
	@test "$(CONFIRM_MIGRATION_DOWN)" = "yes" || (echo "Refusing migration rollback; set CONFIRM_MIGRATION_DOWN=yes only for an isolated database" >&2; exit 1)
	migrate -path db/migration -database "$(DB_URL)" -verbose down

migratedown1:
	@test "$(CONFIRM_MIGRATION_DOWN)" = "yes" || (echo "Refusing migration rollback; set CONFIRM_MIGRATION_DOWN=yes only for an isolated database" >&2; exit 1)
	migrate -path db/migration -database "$(DB_URL)" -verbose down 1

new_migration:
	migrate create -ext sql -dir db/migration -seq $(name)

sqlc:
	sqlc generate

format-check:
	@unformatted="$$(gofmt -l .)"; \
	if [ -n "$$unformatted" ]; then \
		printf 'Unformatted Go files:\n%s\n' "$$unformatted" >&2; \
		exit 1; \
	fi

test:
	go test -v ./...

test-race:
	go test -race ./...

vet:
	go vet ./...

build:
	go build ./...

# A read-only gate for code/doc contracts. CI also verifies SQLC generation
# and runs integration tests with a disposable bdspro_test database.
check: format-check swagger test test-race vet build

# Raw server startup retains existing behavior: settings from app.env/OS.
server:
	go run .

# The OpenAPI JSON is versioned, NOT generated by this target.
swagger:
	go test ./internal/api -run TestOpenAPICoverage -count=1
