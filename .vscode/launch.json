{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "BDSPro: Web (local WSL)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}",
      "cwd": "${workspaceFolder}",
      "args": [
        "--config",
        "${workspaceFolder}/custom/conf/app.ini",
        "web"
      ],
      "stopOnEntry": false
    },
    {
      "name": "BDSPro: Logging tests",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${workspaceFolder}/modules/log",
      "args": [
        "-test.v",
        "-test.run",
        "TestCompactConsolePreservesOriginalEvent|TestCallerLoggerPaths|TestDestinationFiltering|TestErrorDetailsPrivacyAndStack"
      ]
    },
    {
      "name": "BDSPro: HTTP lifecycle tests",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${workspaceFolder}/routers",
      "args": [
        "-test.v",
        "-test.run",
        "TestRequestLifecycle|TestAPIErrorDiagnostics"
      ]
    }
  ]
}
