# Local development defaults only. Override with process env for deployment.
ENVIRONMENT=development
# Unsafe outside a localhost-only Docker Compose development network.
ALLOW_CONTAINER_DEV_BIND=false
DB_DRIVER=postgres
DB_SOURCE=postgresql://root:secret@localhost:5432/bdspro?sslmode=disable
SERVER_ADDRESS=127.0.0.1:8080
ALLOWED_ORIGIN=
SMTP_ADDR=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
VERIFICATION_URL=
# Demo key ONLY for loopback development. Set a random secret in a real environment.
ACCESS_TOKEN_KEY=dev-only-local-key-change-before-deployment-2026
