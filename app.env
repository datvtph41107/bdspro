# Development defaults. Docker Compose overrides DB_SOURCE and REDIS_ADDRESS.
# Never use the example credentials/signing key in production.
ENVIRONMENT=development
LOG_FORMAT=json
ALLOWED_ORIGINS=http://localhost:3000
DB_SOURCE=postgresql://root:secret@127.0.0.1:5432/bdspro?sslmode=disable
MIGRATION_URL=file://db/migration
HTTP_SERVER_ADDRESS=0.0.0.0:8080
TOKEN_SYMMETRIC_KEY=01234567890123456789012345678901
ACCESS_TOKEN_DURATION=15m
REFRESH_TOKEN_DURATION=24h
REDIS_ADDRESS=127.0.0.1:6379
EMAIL_SENDER_NAME=BDSPro
EMAIL_SENDER_ADDRESS=
EMAIL_SENDER_PASSWORD=
VERIFY_EMAIL_URL=http://localhost:8080/users/verify_email
