# SimpleBank-compatible local environment; use private credentials outside development.
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000
DB_SOURCE=postgres://root:secret@127.0.0.1:5432/bdspro?sslmode=disable
MIGRATION_URL=file://db/migration
HTTP_SERVER_ADDRESS=127.0.0.1:8080
TOKEN_SYMMETRIC_KEY=01234567890123456789012345678901
ACCESS_TOKEN_DURATION=15m
REFRESH_TOKEN_DURATION=24h
REDIS_ADDRESS=127.0.0.1:6379
EMAIL_SENDER_NAME=BDSPro
EMAIL_SENDER_ADDRESS=
EMAIL_SENDER_PASSWORD=
VERIFY_EMAIL_URL=http://localhost:8080/users/verify_email
