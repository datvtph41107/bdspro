{
  "repository": "datvtph41107/bdspro",
  "commit": "R38: account OAuth authorizations, browser consent and conditional verified OIDC browser login",
  "routes": [
    {
      "method": "GET",
      "path": "/users/me/oauth/authorizations",
      "access": "authenticated"
    },
    {
      "method": "DELETE",
      "path": "/users/me/oauth/authorizations/:client_id",
      "access": "authenticated"
    },
    {
      "method": "GET",
      "path": "/oauth/login",
      "access": "browser_public"
    },
    {
      "method": "POST",
      "path": "/oauth/login",
      "access": "browser_public_csrf"
    },
    {
      "method": "POST",
      "path": "/oauth/logout",
      "access": "browser_session_csrf"
    },
    {
      "method": "GET",
      "path": "/oauth/login/oidc/start",
      "access": "browser_public_oidc_configured"
    }
  ]
}
