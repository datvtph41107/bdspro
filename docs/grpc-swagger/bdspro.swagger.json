{
  "swagger": "2.0",
  "info": {
    "title": "BDSPro gRPC-Gateway API",
    "description": "RPC contract. These HTTP mappings are not live until gapi and Gateway are implemented.",
    "version": "0.1.0"
  },
  "tags": [
    {
      "name": "AccountService",
      "description": "The gRPC transport adapter must resolve Account identity from the signed\nBearer JWT plus active PostgreSQL Session, and current Workspace access from\nthe shared Organization service. None of those rules live in generated pb."
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/accounts/me": {
      "get": {
        "summary": "Get the authenticated Account",
        "description": "Requires a valid session-bound JWT. No caller-supplied Account identifier.",
        "operationId": "AccountService_GetCurrentAccount",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetCurrentAccountResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "AccountService"
        ]
      }
    },
    "/v1/accounts/me/workspaces": {
      "get": {
        "summary": "List current Account workspaces",
        "description": "Read memberships from PostgreSQL; role and tenant permissions are not JWT claims.",
        "operationId": "AccountService_ListWorkspaces",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListWorkspacesResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "AccountService"
        ]
      }
    }
  },
  "definitions": {
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1GetCurrentAccountResponse": {
      "type": "object",
      "properties": {
        "accountId": {
          "type": "string",
          "format": "int64",
          "description": "Retained for wire compatibility with the first approved proto contract."
        },
        "user": {
          "$ref": "#/definitions/v1User",
          "description": "Optional typed projection for future clients, not a second identity."
        }
      }
    },
    "v1ListWorkspacesResponse": {
      "type": "object",
      "properties": {
        "workspaces": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Workspace"
          }
        }
      }
    },
    "v1User": {
      "type": "object",
      "properties": {
        "accountId": {
          "type": "string",
          "format": "int64"
        }
      },
      "description": "User is a transport read projection of the signed-in Account.\nIt is not a new User table, a Party subtype or an authorization grant."
    },
    "v1Workspace": {
      "type": "object",
      "properties": {
        "organizationId": {
          "type": "string",
          "format": "int64"
        },
        "organizationName": {
          "type": "string"
        },
        "membershipId": {
          "type": "string",
          "format": "int64"
        },
        "joinedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "Workspace is a live membership read projection, not a persisted role grant."
    }
  }
}
